import java.util.Scanner;
public class ScoreSmasher{
 
    public static void getMenu(){
        //Prints Menu
        System.out.println("Welcome to ScoreSmasher: Record Your Game");
        System.out.println("==========================================");
        System.out.println("New Round = 1");
        System.out.println("View Scores = 2");
        System.out.println("Record/Edit Scores = 3");
        System.out.println("Score Summary = 4");
        System.out.println("Reset ScoreBoard = 5");
        System.out.println("Exit Withdraw = 6");
        System.out.println("--------------------");
        System.out.print("Whats your pick: ");
    }


    public static void getWhoScores(int teamchoice, String team1, String team2, int points){
        //Prints the Team Name of Who Scored
        if (teamchoice == 1){
            System.out.printf("Team %s scored %d points!%n", team1, points);
        } else if (teamchoice == 2){
            System.out.printf("Team %s scored %d points!%n", team2, points);
        } else {
            System.out.println("Invalid Team Choice");
        }
    }

    public static void getScoreSummary(int Team_1_score, int Team_2_score, String team1, String team2){
        //The summary of the Game
        int behind = 0;
        if (Team_1_score > Team_2_score){
            //Team 1 Score is Greater
            behind = Team_1_score - Team_2_score;
        } else if (Team_2_score > Team_1_score){
            //Team 2 Score is Greater
            behind = Team_2_score - Team_1_score;
        }
        System.out.println("");
        System.out.println("Score Summary: ");
        System.out.println("======================");
        System.out.printf("Team %s: %d%n", team1, Team_1_score);
        System.out.printf("Team %s: %d%n", team2, Team_2_score);
        System.out.println("======================");


        if (Team_1_score > Team_2_score){
            System.out.printf("Team %s is leading with %d points%n", team1, Team_1_score);
            System.out.printf("Team %s is behind with %d points%n", team2, behind);
        
        } else if (Team_2_score > Team_1_score){
            System.out.printf("Team %s is leading with %d points%n", team2, Team_2_score);
            System.out.printf("Team %s is behind with %d points%n", team1, behind);
        
        } else {
            System.out.printf("Both teams are tied with %d points !%n", Team_1_score);
        }
        System.out.println("");
    }

    public static void getIfScoreIsActivated (){
        System.out.println("");
        System.out.println("No teams have been created yet, please create a new round first");
        System.out.println("");
    
    }

public static void getHighestScore(int team1Score, int team2Score, String team1, String team2) {
        System.out.println("");
        System.out.println("Highest Score Summary: ");
        System.out.println("======================");
        System.out.printf("Team %s: %d%n", team1, team1Score);
        System.out.printf("Team %s: %d%n", team2, team2Score);
        System.out.println("======================");

        System.out.println("Determining the leading team based on overall score...");
         if (Team_1_score > Team_2_score) {
            System.out.printf("Team %s has the highest score with %d points!%n", team1, team1Score);
        } else if (Team_2_score > Team_1_score) {
            System.out.printf("Team %s has the highest score with %d points!%n", team2, team2Score);
        } else {
            System.out.printf("Both teams are tied with %d points!%n", team1Score);
        }
        System.out.println("");
    }

    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);

        // Team name
        String team1 = "";
        String team2 = "";
        int choice = 0;
        int teamchoice;
        boolean proceed = false;
        boolean scoreActivated = false;
        char case3Choice = ' ';
        int addPointsChoice = 0;
        char returnMenu = ' ';
        int deductPointsChoice = 0;
        int updatePointsChoice = 0;
        // Constants & Running Totals
        int Team_1_score = 0;
        int Team_2_score = 0;
        int Leading_Team = 0; 
        getMenu();
        choice = sc.nextInt();
        while (choice <= 0|| choice > 6){
            System.out.println("");
            System.out.println("Invalid Choice, Try Again");
            System.out.println("");
            getMenu();
            choice = sc.nextInt();
        }
        sc.nextLine();

        while (choice != 6){
            switch (choice){
                case 1://New Round
                //Checks whether the scoreboard has been resetted;
                if (scoreActivated){
                    System.out.println("Reset The ScoreBoard First!");
                    break;
                }
                proceed = false;

                //Input TEAM name
                do{
                    System.out.print("Enter Team 1 name: ");
                    team1 = sc.nextLine();
                    System.out.print("Enter Team 2 name: ");
                    team2 = sc.nextLine();
                    if (team1.isEmpty() || team2.isEmpty()){
                        //Teams must ne non-empty
                    System.out.println("Teams must be non-empty");
                    } else if (team1.equals(team2)){
                        //If Both Teams Have The Same Name
                        System.out.println("Teams must not have the same name");
                    }
                } while (team1.isEmpty() || team2.isEmpty() || (team1.equals(team2)));
                
                scoreActivated = true;

                //Instructions For Scoring
                System.out.println("Enter the team's number, then their points.");
                System.out.printf("Team %s: Enter 1      Team %s: Enter 2%n", team1, team2);
                System.out.printf("Which Team won (0 to Stop): ");
                teamchoice = sc.nextInt();
                while (!proceed){
                    if (teamchoice == 1 || teamchoice == 2){
                        //Score Point
                        System.out.print("How many points did they score: ");
                        int points = sc.nextInt();
                        while (points <= 0){
                            System.out.println("Only Positive Number, Try Again");
                            System.out.print("How many points did they score: ");
                            points = sc.nextInt();
                        }
                        getWhoScores(teamchoice, team1, team2, points);
                        
                        if (teamchoice == 1){
                            Team_1_score += points;
                        } else if (teamchoice == 2){
                            Team_2_score += points;
                        }

                    } else if (teamchoice == 0){
                        //Prints the Summary Of The Game
                        getScoreSummary(Team_1_score, Team_2_score, team1, team2);
                        proceed = true;
                    } else {
                        //Invalid Input
                        System.out.println("Invalid Team Choice, Try Again");
                    }

                    if (!proceed){  
                        //Which Team won the round
                        System.out.printf("Which Team won (0 to Stop): ");
                        teamchoice = sc.nextInt();
                    }
                }
                    break;  

                //Case 2 wala pa & Case 3 unfinished
                case 2:
                //highest score
                    if (!scoreActivated) {
                        System.out.println("Team with the Highest Score");
                        System.out.println("");
                        break;
                    }
                    System.out.println("Current Scores:");
                    System.out.printf("Team %s: %.2f%n", team1, Team_1_score);
                    System.out.printf("Team %s: %.2f%n", team2, Team_2_score);
                    if (Team_1_score > Team_2_score) {
                        System.out.printf("Team %s is currently leading with %.2f points.%n", team1, Team_1_score);
                    } else if (Team_2_score > Team_1_score) {
                        System.out.printf("Team %s is currently leading with %.2f points.%n", team2, Team_2_score);
                    } else {
                        System.out.printf("Both teams are tied with %.2f points.%n", Team_1_score);
                    }
                        getHighestScore(Team_1_score, Team_2_score, team1, team2);
                    break;

                case 3:
                    //Record/Edit Scores
                    if (!scoreActivated){
                        getIfScoreIsActivated();
                        break;
                    }
                    do {
                        System.out.println("");
                        System.out.println("==========================================");
                        System.out.println("(A) ADD (U) UPDATE (D) DEDUCT (E) EXIT");
                        System.out.println("----------------------------------------");
                        System.out.print("Whats your pick: ");
                        case3Choice = sc.next().charAt(0);
                        switch (case3Choice){
                            case 'A':
                                do{
                                    System.out.println("Add Points to which team?");
                                    System.out.printf("Team %s: Enter 1      Team %s: Enter 2%n", team1, team2);
                                    System.out.printf("Team %s scored %d points%n", team1, Team_1_score);
                                    System.out.printf("Team %s scored %d points%n", team2, Team_2_score);
                                    System.out.println("----------------------------------------");
                                    System.out.print("Add Points to which team (0 to Stop): ");
                                    addPointsChoice = sc.nextInt();
                                    int addPointsTeam = 0;
                                    if (addPointsChoice == 1){
                                        System.out.printf("How many points to add for Team %s: ", team1);
                                        addPointsTeam = sc.nextInt();
                                        if (addPointsTeam > 0){
                                            Team_1_score += addPointsTeam;
                                        } else {
                                            System.out.println("");
                                            System.out.println("Positive Numbers Only");
                                            System.out.println("");
                                        }
                                        System.out.printf("Team %s score: %d%n", team1, Team_1_score);
                                    } else if (addPointsChoice == 2){
                                        System.out.printf("How many points added for %s: ", team2);
                                        addPointsTeam = sc.nextInt();
                                        if (addPointsTeam > 0){
                                            Team_2_score += addPointsTeam;
                                        } else {
                                            System.out.println("");
                                            System.out.println("Positive Numbers Only");
                                            System.out.println("");
                                        }
                                        System.out.printf("Team %s score: %d%n", team2, Team_2_score);

                                    } else if(addPointsChoice != 1 && addPointsChoice != 2 && addPointsChoice != 0){
                                        System.out.println("");
                                        System.out.println("Invalid Team Choice, Try Again");
                                        System.out.println("");
                                    }
                                } while (addPointsChoice != 0);
                                break;

                            case 'U':
                                    do{
                                        System.out.println("Update Points to which team?");
                                        System.out.printf("Team %s: Enter 1      Team %s: Enter 2%n", team1, team2);
                                        System.out.printf("Team %s scored %d points%n", team1, Team_1_score);
                                        System.out.printf("Team %s scored %d points%n", team2, Team_2_score);
                                        System.out.println("----------------------------------------");
                                        System.out.print("Update Points to which team (0 to Stop): ");
                                        updatePointsChoice = sc.nextInt();
                                        if (updatePointsChoice == 1){
                                            System.out.printf("Change the Score of Team %s: ", team1);
                                            int changeScore = sc.nextInt();
                                            if (changeScore < 0){
                                                System.out.println("");
                                                System.out.println("No Negative Numbers Allowed");
                                                System.out.println("");
                                                continue;
                                            }
                                            Team_1_score = changeScore;
                                            System.out.println("");
                                            System.out.printf("Score Updated for %s%n", team1);
                                            System.out.println("");
                                        } else if (updatePointsChoice == 2){
                                            System.out.printf("Change the Score of Team %s: ", team2);
                                            int changeScore = sc.nextInt();
                                            if (changeScore < 0){
                                                System.out.println("");
                                                System.out.println("No Negative Numbers Allowed");
                                                System.out.println("");
                                                continue;
                                            }
                                            Team_2_score = changeScore;
                                            System.out.println("");
                                            System.out.printf("Score Updated for %s%n", team2);
                                            System.out.println("");
                                        } else if (updatePointsChoice != 1 && updatePointsChoice != 2 && updatePointsChoice != 0){
                                            System.out.println("");
                                            System.out.println("Invalid Team Choice, Try Again");
                                            System.out.println("");
                                        }
                                    } while (updatePointsChoice != 0);
                                break;

                            case 'D':
                                do{
                                    System.out.println("Deduct Points to which team?");
                                    System.out.printf("Team %s: Enter 1      Team %s: Enter 2%n", team1, team2);
                                    System.out.printf("Team %s scored %d points%n", team1, Team_1_score);
                                    System.out.printf("Team %s scored %d points%n", team2, Team_2_score);
                                    System.out.println("----------------------------------------");
                                    System.out.print("Deduct Points to which team (0 to Stop): ");
                                    deductPointsChoice = sc.nextInt();
                                    int deductPointsTeam = 0;
                                    if (deductPointsChoice == 1){
                                        System.out.printf("How many points deducted for Team %s: ", team1);
                                        deductPointsTeam = sc.nextInt();
                                        if (deductPointsTeam > Team_1_score){
                                            System.out.println("Score can't go below 0, set to 0.");
                                            Team_1_score = 0;
                                        } else if (deductPointsTeam > 0){
                                            Team_1_score -= deductPointsTeam;
                                        } else {
                                            System.out.println("");
                                            System.out.println("Positive Numbers Only");
                                            System.out.println("");
                                        }
                                        System.out.printf("Team %s score: %d%n", team1, Team_1_score);
                                    } else if (deductPointsChoice == 2){
                                        System.out.printf("How many points deducted for Team %s: ", team2);
                                        deductPointsTeam = sc.nextInt();
                                        if (deductPointsTeam > Team_2_score){
                                            System.out.println("Score can't go below 0, set to 0.");
                                            Team_2_score = 0;
                                        } else if (deductPointsTeam > 0){
                                            Team_2_score -= deductPointsTeam;
                                        } else {
                                            System.out.println("");
                                            System.out.println("Positive Numbers Only");
                                            System.out.println("");
                                        }
                                        System.out.printf("Team %s score: %d%n", team2, Team_2_score);

                                    } else if(deductPointsChoice != 1 && deductPointsChoice != 2 && deductPointsChoice != 0){
                                        System.out.println("");
                                        System.out.println("Invalid Team Choice, Try Again");
                                        System.out.println("");
                                    }
                                } while (deductPointsChoice != 0);
                            break;

                            default:
                                if (case3Choice != 'E'){
                                    System.out.println("Invalid Choice, Try Again");
                                    break;
                                }
                            }
                        } while(case3Choice != 'E');
                    break;
                case 4:
                    //Score Summary
                    if (!scoreActivated){
                        getIfScoreIsActivated();
                        break;
                    }
                    getScoreSummary(Team_1_score, Team_2_score, team1, team2);
                    break;
                

                case 5:
                    //Reset ScoreBoard

                    System.out.print("Do you wish to reset the ScoreBoard (Y/N): ");
                    char resetScoreBoard = sc.next().charAt(0);

                    if (resetScoreBoard == 'Y'){
                    team1 = "";
                    team2 = "";
                    Team_1_score = 0;
                    Team_2_score = 0;
                    System.out.println("ScoreBoard Reset!");
                    System.out.println("");
                    scoreActivated = false;
                    } else {
                        System.out.println("ScoreBoard Unchanged!");
                        System.out.println("");
                    }
                    break;
                
                default:
                    System.out.println("Invalid Choice, Try Again");
                    break;
                }

                do{
                    System.out.print("Return to menu (Y/N): ");
                    returnMenu = sc.next().charAt(0);
                    System.out.println("");
                    if (returnMenu != 'N' && returnMenu != 'Y'){
                        System.out.println("Invalid Choice, Try Again");
                    }
                } while(returnMenu != 'Y' && returnMenu != 'N');

                if (returnMenu == 'N'){
                    break;
                }
                    getMenu();
                    choice = sc.nextInt();
                    sc.nextLine();
            }
        System.out.println("Thank You For Using ScoreSmasher");
        sc.close();
    }
}
